#include <stdio.h>
#include <math.h>

constexpr float PI = 3.14159265358979323846f;

int main() {

    int opcao;
    float num1, num2, resultado;

    printf("========== CALCULADORA ==========\n");
    printf("1.  Soma\n");
    printf("2.  Subtração\n");
    printf("3.  Multiplicação\n");
    printf("4.  Divisão\n");
    printf("5.  Potenciação\n");
    printf("6.  Raiz quadrada\n");
    printf("7.  Raiz cúbica\n");
    printf("8.  Seno\n");
    printf("9.  Cosseno\n");
    printf("10. Tangente\n");
    printf("11. Logaritmo natural\n");
    printf("12. Logaritmo na base 10\n");
    printf("13. Valor absoluto\n");
    printf("14. Cálculo de porcentagem\n");
    printf("15. Média aritmética\n");
    printf("16. Graus para radianos\n");
    printf("17. Radianos para graus\n");
    printf("18. Área do círculo\n");
    printf("19. Área do retângulo\n");
    printf("20. Hipotenusa\n");
    printf("21. Sair\n");
    printf("=================================\n");

    while (1) {

    printf("Digite a opção: ");
    scanf("%d", &opcao);
    if (opcao == 21) {
        printf("Saindo da calculadora...\n");
        return 0;
    }
    if (opcao < 1 || opcao > 21) {
        printf("Opção inválida! Escolha uma opção de 1 a 21.\n");
        continue;
    }

    if (opcao == 1) {

        printf("Digite o primeiro número: ");
        scanf("%f", &num1);

        printf("Digite o segundo número: ");
        scanf("%f", &num2);

        resultado = num1 + num2;

        printf("Resultado: %.2f\n", resultado);

    } else if (opcao == 2) {

        printf("Digite o primeiro número: ");
        scanf("%f", &num1);

        printf("Digite o segundo número: ");
        scanf("%f", &num2);

        resultado = num1 - num2;

        printf("Resultado: %.2f\n", resultado);

    } else if (opcao == 3) {

        printf("Digite o primeiro número: ");
        scanf("%f", &num1);

        printf("Digite o segundo número: ");
        scanf("%f", &num2);

        resultado = num1 * num2;

        printf("Resultado: %.2f\n", resultado);

    } else if (opcao == 4) {

        printf("Digite o primeiro número: ");
        scanf("%f", &num1);

        printf("Digite o segundo número: ");
        scanf("%f", &num2);

        if (num2 != 0) {
            resultado = num1 / num2;
            printf("Resultado: %.2f\n", resultado);
        } else {
            printf("Erro: não é possível dividir por zero.\n");
        }

    } else if (opcao == 5) {

        printf("Digite a base: ");
        scanf("%f", &num1);

        printf("Digite o expoente: ");
        scanf("%f", &num2);

        resultado = pow(num1, num2);

        printf("Resultado: %.2f\n", resultado);

    } else if (opcao == 6) {

        printf("Digite um número: ");
        scanf("%f", &num1);

        if (num1 >= 0) {
            resultado = sqrt(num1);
            printf("Raiz quadrada: %.2f\n", resultado);
        } else {
            printf("Erro: não existe raiz quadrada real de número negativo.\n");
        }

    } else if (opcao == 7) {

        printf("Digite um número: ");
        scanf("%f", &num1);

        resultado = cbrt(num1);

        printf("Raiz cúbica: %.2f\n", resultado);

    } else if (opcao == 8) {

        printf("Digite o ângulo em graus: ");
        scanf("%f", &num1);

        resultado = sin(num1 * PI / 180);

        printf("Seno: %.4f\n", resultado);

    } else if (opcao == 9) {

        printf("Digite o ângulo em graus: ");
        scanf("%f", &num1);

        resultado = cos(num1 * PI / 180);

        printf("Cosseno: %.4f\n", resultado);

    } else if (opcao == 10) {

        printf("Digite o ângulo em graus: ");
        scanf("%f", &num1);

        resultado = tan(num1 * PI / 180);

        printf("Tangente: %.4f\n", resultado);

    } else if (opcao == 11) {

        printf("Digite um número: ");
        scanf("%f", &num1);

        if (num1 > 0) {
            resultado = log(num1);
            printf("Logaritmo natural: %.4f\n", resultado);
        } else {
            printf("Erro: o número deve ser maior que zero.\n");
        }

    } else if (opcao == 12) {

        printf("Digite um número: ");
        scanf("%f", &num1);

        if (num1 > 0) {
            resultado = log10(num1);
            printf("Logaritmo base 10: %.4f\n", resultado);
        } else {
            printf("Erro: o número deve ser maior que zero.\n");
        }

    } else if (opcao == 13) {

        printf("Digite um número: ");
        scanf("%f", &num1);

        resultado = fabs(num1);

        printf("Valor absoluto: %.2f\n", resultado);

    } else if (opcao == 14) {

        printf("Digite o número: ");
        scanf("%f", &num1);

        printf("Digite a porcentagem: ");
        scanf("%f", &num2);

        resultado = (num1 * num2) / 100;

        printf("Resultado: %.2f\n", resultado);

    } else if (opcao == 15) {

        printf("Digite o primeiro número: ");
        scanf("%f", &num1);

        printf("Digite o segundo número: ");
        scanf("%f", &num2);

        resultado = (num1 + num2) / 2;

        printf("Média aritmética: %.2f\n", resultado);

    } else if (opcao == 16) {

        printf("Digite o valor em graus: ");
        scanf("%f", &num1);

        resultado = num1 * PI / 180;

        printf("Radianos: %.4f\n", resultado);

    } else if (opcao == 17) {

        printf("Digite o valor em radianos: ");
        scanf("%f", &num1);

        resultado = num1 * 180 / PI;

        printf("Graus: %.4f\n", resultado);

    } else if (opcao == 18) {

        printf("Digite o raio do círculo: ");
        scanf("%f", &num1);

        if (num1 >= 0) {
            resultado = PI * num1 * num1;
            printf("Área do círculo: %.2f\n", resultado);
        } else {
            printf("Erro: o raio não pode ser negativo.\n");
        }

    } else if (opcao == 19) {

        printf("Digite a base: ");
        scanf("%f", &num1);

        printf("Digite a altura: ");
        scanf("%f", &num2);

        if (num1 >= 0 && num2 >= 0) {
            resultado = num1 * num2;
            printf("Área do retângulo: %.2f\n", resultado);
        } else {
            printf("Erro: os valores não podem ser negativos.\n");
        }

    } else if (opcao == 20) {

        printf("Digite o primeiro cateto: ");
        scanf("%f", &num1);

        printf("Digite o segundo cateto: ");
        scanf("%f", &num2);

        if (num1 >= 0 && num2 >= 0) {
            resultado = sqrt(num1 * num1 + num2 * num2);
            printf("Hipotenusa: %.2f\n", resultado);
        } else {
            printf("Erro: os catetos não podem ser negativos.\n");
        }

    } else {

        printf("Opção inválida! Escolha uma opção de 1 a 21.\n");

    }
    }

    return 0;
}
